{
  "name": "vite_tailwind",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "concurrently 'npx biome check src/**/*' 'npx markuplint src/**/*.html' -c '#60a5fa,#663399,#1572eb'",
    "check:js": "biome check src/**/*.js",
    "check:css": "biome check src/**/*.css",
    "check:html": "concurrently 'npx biome check src/**/*.html' 'npx markuplint src/**/*.html'",
    "fix": "biome check --write src/**/*",
    "fix:js": "biome check --write src/js/**/*.js",
    "fix:css": "biome check --write src/css/**/*.css",
    "test": "npx playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "browserslist": "^4.28.5",
    "concurrently": "^10.0.3",
    "glob": "^13.0.6",
    "lightningcss": "^1.32.0",
    "markuplint": "^4.18.3",
    "postcss": "^8.5.16",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-import-ext-glob": "^2.1.1",
    "postcss-lightningcss": "^1.1.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.35.3",
    "svgo": "^4.0.1",
    "vite": "^8.1.4",
    "vite-plugin-image-optimizer": "^2.0.3"
  },
  "dependencies": {
    "tailwindcss": "^4.3.2"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
